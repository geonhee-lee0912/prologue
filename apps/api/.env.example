# =====================================================================
# apps/api 환경변수 템플릿
#
# 새 컴퓨터에서 세팅할 때:
#   1. cp apps/api/.env.example apps/api/.env
#   2. 아래 빈 값을 채운다 (출처는 각 항목 주석 참조)
#
# 값은 git 에 올리지 않는다. 비밀번호 관리자에 보관한다.
# 자세한 다중 컴퓨터 운용 방법은 README 의 "환경변수" 절 참조.
# =====================================================================

# =====================================================================
# 공통 (루트 .env.example 에서 가져옴)
#
# 각 앱별로 .env 가 따로 있다 (apps/api/.env, apps/mobile/.env, apps/admin/.env).
# 이 루트 .env 는 개발자 노트와 공유 변수만 둔다.
#
# 운영 환경에서는 .env 파일을 사용하지 않는다.
# - NestJS: Railway 의 환경 변수 UI 에서 관리
# - Mobile: EAS Secret 으로 관리
# - Admin: Vercel 환경 변수 UI 에서 관리
# - Supabase: Supabase 대시보드 (Auth/Storage 설정)
# =====================================================================

# ----- 공통 -----
NODE_ENV=development
TZ=Asia/Seoul

# ----- 작업 환경 식별 -----
# 'dev' 또는 'prod' — 어떤 Supabase 프로젝트를 사용 중인지 명확히 하기 위함
PROLOGUE_ENV=dev

# =====================================================================
# apps/api 전용
# =====================================================================

# ----- Supabase DB (Prisma) -----
# Supabase 대시보드 → Settings → Database
#   DATABASE_URL: Connection pooling 섹션, 포트 6543, 끝에 ?pgbouncer=true
#   DIRECT_URL  : Connection string 섹션, 포트 5432 (마이그레이션 전용)
DATABASE_URL=
DIRECT_URL=

# ----- Supabase API -----
# Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ----- 서버 -----
PORT=3001
LOG_LEVEL=debug
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:8081

# ----- 보안 -----
# 휴대폰 번호 해싱용 pepper. 아무 긴 랜덤 문자열.
# 생성: openssl rand -hex 32
PHONE_HASH_PEPPER=
ADMIN_JWT_SECRET=

# ----- 카카오 로그인 -----
# mock 이면 실 연동 없이 동작. 실 연동은 BACKLOG.md 1번 참조.
KAKAO_USER_INFO_PROVIDER=mock
KAKAO_REST_API_KEY=

# ----- LLM (갈피 AI 엔진) -----
# mock | openai. 운영(NODE_ENV=production)에서 mock 이면 서버가 뜨지 않는다.
# openai 는 민감정보·국외이전 동의를 받은 뒤에만 켠다 (CLAUDE.md 10.2b·10.2c)
LLM_PROVIDER=mock
OPENAI_API_KEY=
LLM_MODEL=gpt-5.6-luna
